{
  "uid": "serverless-api-observability",
  "title": "Serverless API Observability (Local)",
  "schemaVersion": 39,
  "version": 2,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "API latency quantiles (seconds)",
      "description": "p50, p95 and p99 estimated from explicit histogram buckets. The red line marks the 500 ms alert threshold.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 0.5
              }
            ]
          },
          "custom": {
            "thresholdsStyle": {
              "mode": "line"
            }
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, api_target) (rate(api_check_duration_seconds_bucket[5m])))",
          "legendFormat": "p95 {{api_target}}"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.50, sum by (le, api_target) (rate(api_check_duration_seconds_bucket[5m])))",
          "legendFormat": "p50 {{api_target}}"
        },
        {
          "refId": "C",
          "expr": "histogram_quantile(0.99, sum by (le, api_target) (rate(api_check_duration_seconds_bucket[5m])))",
          "legendFormat": "p99 {{api_target}}"
        }
      ]
    },
    {
      "id": 2,
      "title": "API check rate",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (api_target, result) (rate(api_check_requests_total[5m]))",
          "legendFormat": "{{api_target}} - {{result}}"
        }
      ]
    },
    {
      "id": 3,
      "title": "Current API status",
      "description": "Latest result per target: UP (1) or DOWN (0).",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 6,
        "w": 12,
        "x": 0,
        "y": 9
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "DOWN",
                  "color": "red",
                  "index": 0
                },
                "1": {
                  "text": "UP",
                  "color": "green",
                  "index": 1
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "api_check_status",
          "instant": true,
          "legendFormat": "{{api_target}}"
        }
      ]
    },
    {
      "id": 4,
      "title": "Time since last check",
      "description": "A rising value can indicate that the monitor stopped reporting.",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 6,
        "w": 12,
        "x": 12,
        "y": 9
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 600
              },
              {
                "color": "red",
                "value": 900
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "time() - api_check_last_run_timestamp_seconds",
          "instant": true,
          "legendFormat": "{{api_target}}"
        }
      ]
    },
    {
      "id": 5,
      "title": "Healthy checks (%) — 15m",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 15
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * sum by (api_target) (rate(api_check_requests_total{result=\"healthy\"}[15m])) / sum by (api_target) (rate(api_check_requests_total[15m]))",
          "legendFormat": "{{api_target}}"
        }
      ]
    },
    {
      "id": 6,
      "title": "HTTP response codes — checks/min",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 15
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqpm"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "60 * sum by (api_target, status_code) (rate(api_check_requests_total[15m]))",
          "legendFormat": "{{api_target}} — HTTP {{status_code}}"
        }
      ]
    },
    {
      "id": 7,
      "title": "Average latency — 15m (seconds)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 23
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (api_target) (rate(api_check_duration_seconds_sum[15m])) / sum by (api_target) (rate(api_check_duration_seconds_count[15m]))",
          "legendFormat": "{{api_target}}"
        }
      ]
    },
    {
      "id": 8,
      "title": "API health-check logs",
      "type": "logs",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 31
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{service_name=\"serverless-api-observability\"}",
          "queryType": "range",
          "maxLines": 100
        }
      ]
    },
    {
      "id": 9,
      "title": "Recent traces",
      "type": "traces",
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 41
      },
      "targets": [
        {
          "refId": "A",
          "queryType": "traceql",
          "query": "{ resource.service.name = \"serverless-api-observability\" }"
        }
      ]
    }
  ]
}
